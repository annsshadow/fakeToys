# 复制为 .env 后填入真实密钥：cp .env.example .env
#
# 至少配置一个模型后端。未配置的后端在构造时会报错，
# 但只要有一个可用，平台即可正常启动。

# 百度 ERNIE（默认后端）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# 宿主机映射端口
API_PORT=8000

# 镜像标签
IMAGE_TAG=3.0.0

# 设为 1 时安装全部可选依赖（语义模型 / 向量库 / 多模态 / LLM 框架）
INSTALL_OPTIONAL=0

# 写操作鉴权口令（POST/PUT/PATCH/DELETE 需带 X-API-Key）。
# 真值由部署环境注入，不入库；留空时服务端仅放行回环写。
AUGMENTOR_API_KEY=

# 前端子路径部署（可选）：本地/根路径部署留空即可，默认走 '/api'。
# 挂到测试域名 /augmentor/ 时设置：
#   VITE_BASE=/augmentor/
#   VITE_API_BASE=https://<YOUR_TEST_DOMAIN>/augmentor-api/api
VITE_BASE=
VITE_API_BASE=
