# 复制为 .env 后填入真实密钥：cp .env.example .env
#
# 至少配置一个模型后端。未配置的后端在构造时会报错，
# 但只要有一个可用，平台即可正常启动。

# 百度 ERNIE（默认后端）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# 宿主机映射端口
API_PORT=8000

# 镜像标签
IMAGE_TAG=2.0.0

# 设为 1 时安装全部可选依赖（语义模型 / 向量库 / 多模态 / LLM 框架）
INSTALL_OPTIONAL=0
