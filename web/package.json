    "unocss": "^66.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.1.0",
    "tsx": "^4.19.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.1",
    "@tanstack/vue-query": "^5.80.0",
