  "balance_invariants": {
    "_comment": "反通胀与以弱胜强的不变量，两端都必须成立",
    "max_reaction_attack_weight_permille": 300,
    "low_correct_beats_high_no_reaction": true,
    "correct_direction_ratio_min": 1.5
  },
  "levelgen": {
    "_comment": "关卡生成必须确定性。两端同 seed 必须产出完全相同的关卡。",
    "levels": 100,
    "terrain_level_min": 20
  },
  "constants": {
    "_comment": "跨端共享的设计常量，任一端改动都会导致结算分歧",
    "element_per_stack_base": 1200,
    "element_tick_divisor": 40,
    "direct_weight_permille": 400,
    "permille": 1000,
    "max_resist_permille": 500,
    "max_armor_permille": 750,
    "loot_caps": {
      "max_coin_per_battle": 60000,
      "max_keys_per_battle": 3,
      "max_energy_per_battle": 15
    }
  },
  "replay_skills": {
    "_comment": "回放前缀 S 段（技能槽配置）的跨端契约（第 56 轮）。Go 侧 internal/domain/replay_skills_contract_test.go 与 TS 侧 src/game/replay_skills_contract.test.ts 必须同时通过。expected 是字面串 —— 两端各自用**自己的** skillBaseDamageAtLevel / SkillBaseDamageAtLevel 算底伤再拼串，任一端的格式或排序漂移都会在这里露出来。sort 排的是**格式化后的字符串**（TS 的 Array.sort 无参 = UTF-16 码元序，Go 对应 sort.Strings），所以 slot=10 排在 slot=2 前面，这是最容易写错的一处。",
    "cases": [
      {
        "name": "single_level1_no_baking",
        "_why": "level 1 的 coef = 1000，底伤不变；这是最常见的情形，也是格式漂移最容易藏身的地方",
        "skills": [
          { "slot": 0, "skill_id": 1, "level": 1, "base_damage": 100, "heat_cost": 20, "apply_stacks": 1 }
        ],
        "expected": "0:1:100:1:20"
      },
      {
        "name": "slot_ge_10_string_order",
        "_why": "字符串序 ≠ 槽位数值序：10: 排在 2: 前面。按槽位排的实现在这里会红",
        "skills": [
          { "slot": 2, "skill_id": 1, "level": 1, "base_damage": 100, "heat_cost": 20, "apply_stacks": 1 },
          { "slot": 10, "skill_id": 2, "level": 1, "base_damage": 140, "heat_cost": 30, "apply_stacks": 2 }
        ],
        "expected": "10:2:140:2:30,2:1:100:1:20"
      },
      {
        "name": "level_baked_into_base_damage",
        "_why": "等级必须烘进底伤：coef = 1000 + (level-1)*50。level 10 → 145，level 5 → 216",
        "skills": [
          { "slot": 0, "skill_id": 3, "level": 10, "base_damage": 100, "heat_cost": 40, "apply_stacks": 2 },
          { "slot": 1, "skill_id": 4, "level": 5, "base_damage": 180, "heat_cost": 50, "apply_stacks": 3 }
        ],
        "expected": "0:3:145:2:40,1:4:216:3:50"
      },
      {
        "name": "mixed_width_slot_and_4digit_damage",
        "_why": "两位槽位 + 四位底伤一起出现，排错位或漏字段都在这里现形",
        "skills": [
          { "slot": 9, "skill_id": 5, "level": 3, "base_damage": 1000, "heat_cost": 60, "apply_stacks": 1 },
          { "slot": 11, "skill_id": 6, "level": 1, "base_damage": 250, "heat_cost": 70, "apply_stacks": 4 }
        ],
        "expected": "11:6:250:4:70,9:5:1100:1:60"
      },
      {
        "name": "empty_build",
        "_why": "空构筑必须产出空串（而不是 ',,,' 之类），否则空技能玩家会被判不符",
        "skills": [],
        "expected": ""
      }
    ],
    "limits": {
      "_comment": "replay_skills 的长度/条目数上限（第 57 轮）。两处必须一致：Go 的 domain.ReplaySkillsMaxLen / ReplaySkillsMaxEntries，以及 TS 侧 parity 测试读这里的值。measured_* 是 100 关全扫描 + 槽位递增扫描的**实测**结果，不是估计。max_entries 必须 >= BaseSkillSlots(5) + extra_slot 节点数(8) = 13，由 Go 的 TestReplaySkillsEntryCapCoversMaxPossibleSlots 守着。",
      "max_len": 1024,
      "max_entries": 20,
      "measured": {
        "_comment": "客户端真实玩家构筑（ACTIVE_SLOTS = 4）扫 100 关：最长 51 字符 / 4 条。按槽位数递增实测：4 条→51、5 条→64、10 条→130、12 条→160、20 条→280、21 条→293。max_len=1024 远大于条目上限处的 280，所以长度校验**永远不会先于条目数触发** —— 两条边界分开写是为了让「塞了太多条」与「单条离谱地长」能分开报错，而不是为了让长度成为主要闸门。",
        "player_max_len_level1": 50,
        "player_max_len_level99": 51,
        "_levels_note": "两档都记：客户端 parity 扫描（settle_bounds_parity.test.ts）的 buildSnapshot 用 level 缺省即 1，实测 50；把全部技能顶到 level 99（底伤最大）实测 51。上限校验要用更大的那个，所以取 51。",
        "player_max_entries": 4,
        "at_entry_cap_len": 280,
        "worst_single_entry_len": 13,
        "slots_vs_len": {
          "4": 51,
          "5": 64,
          "10": 130,
          "12": 160,
          "20": 280,
          "21": 293
        }
      }
    }
  }
