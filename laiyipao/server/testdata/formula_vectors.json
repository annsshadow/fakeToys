          "roll": 9999
        },
        "expect": {
          "reaction_attack_portion": 247,
          "reaction_elem_portion": 11880,
          "reaction_damage": 6187,
          "direct_damage": 3540,
          "element_damage": 2340,
          "total_damage": 9727,
