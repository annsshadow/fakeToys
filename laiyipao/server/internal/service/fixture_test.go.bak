package service

// 覆盖率攻坚用的两个夹具变体。
//
// openTestService（concurrency_test.go）给出"健康库"环境；
// 这里补两个确定性故障环境：
//
//   - openBrokenService：连接池已关闭。所有查询立刻失败，
//     用于覆盖各函数的"数据库故障"错误分支 —— 这些分支在健康库上
//     永远走不到，但恰恰是出错时唯一被用户看到的东西。
//   - openScratchService：一次性 scratch 库（建库→迁移→种子）。
//     用于"单表故障"场景：把某张表改名，让特定 SQL 必然失败，
//     覆盖"前一步成功、这一步失败"的中间分支（closed pool 只能覆盖第一步）。

import (
	"context"
	"fmt"
	"os"
	"strings"
	"testing"
	"time"

	"github.com/laiyipao/server/internal/config"
	"github.com/laiyipao/server/internal/domain"
	"github.com/laiyipao/server/internal/seeder"
	"github.com/laiyipao/server/internal/store"
	"github.com/laiyipao/server/internal/testutil/scratchdb"
)

// openBrokenService 返回一个底层连接池已关闭的 Service。
func openBrokenService(t *testing.T) *Service {
	t.Helper()
	ts := openTestService(t) // 连不上库会 Skip
	ts.db.Close()            // pgxpool.Close 幂等，cleanup 里的二次 Close 无害
	return ts.Service
}

// openScratchService 返回跑在一次性库上的 Service（已迁移+种子）。
// 库在测试结束时整体 DROP，因此本文件里的"改名/删表"不需要恢复。
func openScratchService(t *testing.T) *testService {
	t.Helper()
	dsn := scratchDSN(t)
	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
	defer cancel()

	cfg := config.Load()
	cfg.DatabaseURL = dsn
	cfg.DBMaxConns = 4
	cfg.DBMinConns = 1

	db, err := store.Open(ctx, cfg)
	if err != nil {
		t.Skipf("scratch 库连不上，跳过：%v", err)
	}
	t.Cleanup(db.Close)
	if err := db.Migrate(ctx); err != nil {
		t.Fatalf("scratch 库迁移失败：%v", err)
	}
	if _, err := seeder.Run(ctx, db.Pool); err != nil {
		dumpSeedState(t, ctx, db, dsn, err)
		t.Fatalf("scratch 库种子失败：%v", err)
	}
	return &testService{Service: New(db, cfg), db: db}
}

// dumpSeedState 在播种失败时把现场打出来（第 150 轮诊断用，根因定位后可删）。
//
// 为什么需要它：`skill_recipes` 报 23505（主键 320 已存在），而播种前
// 逐库查过 `count(*)` 全是 0 —— 「表是空的却撞主键」在单事务下不可能成立。
// 光看报错文本推不出来，只能把**失败之后**的现场固化下来：
//
//   - 表里到底有没有 320？有 → 实锤外部写入者；没有 → 说明报错与这张表无关
//   - 该库上还有谁在连接？→ 找并发播种者
//   - 手工重跑那条 INSERT 能复现吗？→ 区分「数据问题」与「约束/索引问题」
func dumpSeedState(t *testing.T, ctx context.Context, db *store.DB, dsn string, seedErr error) {
	t.Helper()

	var cur string
	_ = db.Pool.QueryRow(ctx, `SELECT current_database()`).Scan(&cur)

	rows, err := db.Pool.Query(ctx,
		`SELECT id, output_skill_id, a_skill_id, b_skill_id FROM skill_recipes ORDER BY id`)
	if err != nil {
		t.Logf("[dump] cur=%s want=%s 查询 skill_recipes 失败：%v", cur, dsn, err)
		return
	}
	var got []string
	for rows.Next() {
		var id, out, a, b int32
		_ = rows.Scan(&id, &out, &a, &b)
		got = append(got, fmt.Sprintf("%d(out=%d,%d+%d)", id, out, a, b))
	}
	rows.Close()
	rowsErr := rows.Err()

	// 同一库上的其它会话：并发播种者会在这里现形
	others, err2 := db.Pool.Query(ctx, `
		SELECT pid, state, left(query, 90)
		FROM pg_stat_activity
		WHERE datname = current_database() AND pid <> pg_backend_pid()
		ORDER BY pid`)
	var sessions []string
	if err2 == nil {
		for others.Next() {
			var pid int32
			var state, q string
			_ = others.Scan(&pid, &state, &q)
			sessions = append(sessions, fmt.Sprintf("pid=%d %s %q", pid, state, q))
		}
		others.Close()
	}

	// 手工重跑那条 INSERT：在「空表」上能复现，就说明问题在约束/索引形状，
	// 而不是数据 —— 那是完全不同的一条线索。
	_, reproErr := db.Pool.Exec(ctx, `
		INSERT INTO skill_recipes (id, output_skill_id, a_skill_id, b_skill_id, output_tier)
		VALUES (320, 32, 2, 11, 2)
		ON CONFLICT (a_skill_id, b_skill_id) DO UPDATE SET
			output_skill_id=EXCLUDED.output_skill_id, output_tier=EXCLUDED.output_tier`)

	// 第二次 Run：这是「本次 Run 自己撞自己」与「外部写入者」的分水岭。
	// 空表 + 一次 Run + 18 个不重复 id + (a,b) 唯一索引齐全 ⇒ 单次 Run 不可能撞 PK；
	// 而若 Run **不幂等**（第二遍就撞），那 admin.EnsureContentSeeded 与
	// cmd/seed 注释里承诺的「幂等 upsert」就是假的。
	_, secondErr := seeder.Run(ctx, db.Pool)

	// 索引实况：PG 到底认了哪些唯一约束（ON CONFLICT 的仲裁索引是否在列）
	idx, err3 := db.Pool.Query(ctx, `
		SELECT indexname, indexdef FROM pg_indexes
		WHERE tablename = 'skill_recipes' ORDER BY indexname`)
	var indexes []string
	if err3 == nil {
		for idx.Next() {
			var name, def string
			_ = idx.Scan(&name, &def)
			indexes = append(indexes, name+" = "+def)
		}
		idx.Close()
	}

	// 配方字面量实况：运行期是否有重复 Output（编译期看不出被谁改过）
	dupOut := map[int]int{}
	for _, r := range domain.SeedRecipes {
		dupOut[r.Output]++
	}
	var dupIDs []string
	for k, v := range dupOut {
		if v > 1 {
			dupIDs = append(dupIDs, fmt.Sprintf("Output=%d 出现 %d 次", k, v))
		}
	}

	t.Logf("[dump] 原始错误=%v\n[dump] cur=%s want=%s\n[dump] 失败后 skill_recipes 行数=%d %v (rowsErr=%v)\n"+
		"[dump] 同库其它会话=%v\n[dump] 空表重跑 INSERT(320) → %v\n[dump] 第二次 seeder.Run → %v\n"+
		"[dump] SeedRecipes 条数=%d 重复=%v\n[dump] 索引=%v",
		seedErr, cur, dsn, len(got), got, rowsErr, sessions, reproErr, secondErr,
		len(domain.SeedRecipes), dupIDs, indexes)
}

// scratchPrefix 是本包一次性库的命名前缀。
// 改动必须同步登记到 scratchdb.Prefixes（见 scratchdb 的文档注释）。
const scratchPrefix = "laiyipao_svc_test_"

// TestMain 跑测试前清掉本包前缀下的残留库。
//
// 没有它，孤儿库会**累积**：单次跑测留下的孤儿让下一次跑测开始失败，
// 于是「跑得越多越红」。docs/audits/coverage-2026-09-28.md §6 记过这件事
// （曾残留 1049 个），但当时只做了一次性清理，没留下机制，必然复发。
func TestMain(m *testing.M) {
	if n, err := scratchdb.SweepPrefix(scratchPrefix); err != nil {
		fmt.Fprintf(os.Stderr, "[scratchdb] 清理残留库失败（不阻断）：%v\n", err)
	} else if n > 0 {
		fmt.Fprintf(os.Stderr, "[scratchdb] 已清理 %d 个残留测试库（前缀 %s）\n", n, scratchPrefix)
	}
	os.Exit(m.Run())
}

// scratchDSN 建一次性库并返回其 DSN（第 150 轮收敛到 internal/testutil/scratchdb）。
//
// 本仓库原先在 5 个包里各抄了一份，抄出了三个真实故障：
// 库名每秒重复、DROP 超时留孤儿、建库失败静默跳过。详见该包的文档注释。
func scratchDSN(t *testing.T) string {
	t.Helper()
	return scratchdb.DSN(t, scratchPrefix)
}

// (ts) renameTable 临时把表改名。scratch 库专用 —— 不恢复，
// 但同一用例内继续跑的步骤必须知晓这一点。
func (ts *testService) renameTable(t *testing.T, from, to string) {
	t.Helper()
	if _, err := ts.pool.Exec(context.Background(),
		fmt.Sprintf(`ALTER TABLE %s RENAME TO %s`, from, to)); err != nil {
		t.Fatalf("改名 %s → %s 失败：%v", from, to, err)
	}
}

// (ts) exec 执行任意 SQL（数据准备）。
func (ts *testService) exec(t *testing.T, q string, args ...any) {
	t.Helper()
	if _, err := ts.pool.Exec(context.Background(), q, args...); err != nil {
		t.Fatalf("执行失败（%s）：%v", q, err)
	}
}

// mustErr 断言 err != nil 且错误信息包含 want 子串（want 为空则只要求非 nil）。
func mustErr(t *testing.T, err error, want string) {
	t.Helper()
	if err == nil {
		t.Fatalf("应返回错误（期望含 %q）却成功了", want)
	}
	if want != "" && !strings.Contains(err.Error(), want) {
		t.Fatalf("错误 %q 不包含期望片段 %q", err.Error(), want)
	}
}
