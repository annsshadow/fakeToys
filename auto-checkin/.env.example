# ==========================================================================
# 复制本文件为 .env 并填入真实账号密码。.env 已被 .gitignore 排除，绝不入库。
# 未填写账号密码的站点会被自动跳过。
# ==========================================================================

# ---- 站点 1: vyceai (点击签到即可领取) ----
VYCEAI_EMAIL=
VYCEAI_PASSWORD=

# ---- 站点 2: agentrouter (需退出重新登录才能领取) ----
AGENTROUTER_EMAIL=
AGENTROUTER_PASSWORD=

# ---- 站点 3: justwoker (每天访问即可领取) ----
JUSTWOKER_EMAIL=
JUSTWOKER_PASSWORD=

# ---- Web 面板 ----
# 仅监听本机，避免账号信息暴露到局域网。如需外部访问请自行评估风险。
PANEL_HOST=127.0.0.1
PANEL_PORT=8787
# 可选：为面板设置访问口令（留空则本机免密访问）
PANEL_TOKEN=
