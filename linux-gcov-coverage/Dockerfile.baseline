FROM debian:bookworm

# 使用 GCC 12：内核 7.1.3 早于 GCC 14 更严格的内联规则，GCC 14 + gcov 插桩会在
# kernel/sched 的 unity-build 中因 __always_inline 无法内联而硬报错；bookworm 的
# GCC 12 是该内核时代验证过的工具链。
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update -qq && \
    apt-get install -y -qq \
        gcc \
        make \
        libssl-dev \
        libelf-dev \
        bc \
        python3 \
        python3-pip \
        lcov \
        flex \
        bison \
        busybox-static \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["bash"]
