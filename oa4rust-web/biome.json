{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "root": "..",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error"
      },
      "suspicious": {
        "noConsole": "off",
        "useIterableCallbackReturn": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noGlobalIsNan": "error",
        "noTemplateCurlyInString": "error"
      },
      "complexity": {
        "noCommaOperator": "error",
        "noBannedTypes": "error",
        "useOptionalChain": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/apis/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "correctness": { "noUnusedVariables": "off" }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "correctness": { "noUnusedVariables": "off" },
          "style": { "useVueMultiWordComponentNames": "off" }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "complexity": { "noBannedTypes": "off" }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off",
            "useIterableCallbackReturn": "off"
          },
          "correctness": { "noUnusedVariables": "off" }
        }
      }
    },
    {
      "includes": ["**/sandbox.html"],
      "linter": {
        "rules": {
          "security": { "noGlobalEval": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  }
}
