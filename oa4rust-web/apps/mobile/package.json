{
  "name": "@oa4rust/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OA4Rust 跨平台移动端（uni-app：H5 / App / 微信小程序）",
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build": "uni build",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-i18n": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-stat": "3.0.0-alpha-5020620260914001",
    "pinia": "^2.3.1",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020620260914001",
    "@oa4rust/sdk": "workspace:*",
    "@types/node": "^24.0.0",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "^5.8.0",
    "vite": "5.2.8"
  }
}
