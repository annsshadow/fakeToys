# rust
oa4rust/target*/
oa4rust/.pgdata/
oa4rust/__pycache__/
# scripts 目录整体忽略，但端点生成器必须纳入版本控制以保证可复现（plan002 U9）
oa4rust/scripts/**
!oa4rust/scripts/
!oa4rust/scripts/gen_openapi_paths.py
!oa4rust/scripts/extract_routes.py
# 端点/路由/测试生成器：其产物（openapi/src/lib.rs、tests_generated.rs、
# generated_tests.rs、generated_routes.rs、tests/behavior_comparison/endpoints.rs）
# 已纳入版本控制，故生成器自身也须纳入以保证可复现（plan002 U9 / R8）。
!oa4rust/scripts/extract_endpoints.py
!oa4rust/scripts/regen_endpoints.py
!oa4rust/scripts/generate_handler_tests.py
!oa4rust/scripts/generate_parity_tests.py
!oa4rust/scripts/gen_mcp_tools.py
# OpenAPI 安全方案守卫脚本（CI 调用，见 oa4rust/.github/workflows/ci.yml）
!oa4rust/scripts/check_openapi_security.py
# 差异聚类脚本（U2）：分析 behavior-report.md，产出候选改名对到 target/
!oa4rust/scripts/cluster_behavior_diffs.py
!oa4rust/scripts/validate_rustsec_exceptions.py
# S4 pilot 日志离线门禁（独立 workflow 调用）。
!oa4rust/scripts/pilot_gate.py

# log
*.log

# secrets
oa4rust/scripts/.token
oa4rust/check_designer.txt
oa4rust/check_tables.sql
oa4rust/deploy/.backups/

*.txt
!oa4rust/docs/ops/*.txt
# 审计/对账的文本证据（可读报告、候选路由对照）需入库，否则审计不可复现。
!docs/audits/**/*.txt
# augmentor 子项目的依赖清单必须纳入版本控制：CI 的 cache-dependency-path、
# Dockerfile 的 COPY requirements.txt 均依赖之，缺失会直接导致构建失败。
!augmentor/requirements.txt
!augmentor/requirements-core.txt
!augmentor/requirements-dev.txt
scripts/cleanup_*.js

# Environment secrets
oa4rust/.env
oa4rust/scripts/.token
scripts/.java-seed-ids.json

