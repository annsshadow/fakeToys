# rust
oa4rust/backend/target*/
oa4rust/backend/.pgdata/
oa4rust/backend/__pycache__/
# scripts 目录整体忽略，但端点生成器必须纳入版本控制以保证可复现（plan002 U9）
oa4rust/backend/scripts/**
!oa4rust/backend/scripts/
!oa4rust/backend/scripts/gen_openapi_paths.py
!oa4rust/backend/scripts/extract_routes.py
# 端点/路由/测试生成器：其产物（openapi/src/lib.rs、tests_generated.rs、
# generated_tests.rs、generated_routes.rs、tests/behavior_comparison/endpoints.rs）
# 已纳入版本控制，故生成器自身也须纳入以保证可复现（plan002 U9 / R8）。
!oa4rust/backend/scripts/extract_endpoints.py
!oa4rust/backend/scripts/regen_endpoints.py
!oa4rust/backend/scripts/generate_handler_tests.py
!oa4rust/backend/scripts/generate_parity_tests.py
!oa4rust/backend/scripts/gen_mcp_tools.py
# OpenAPI 安全方案守卫脚本（CI 调用，见 oa4rust/.github/workflows/ci.yml）
!oa4rust/backend/scripts/check_openapi_security.py
# 差异聚类脚本（U2）：分析 behavior-report.md，产出候选改名对到 target/
!oa4rust/backend/scripts/cluster_behavior_diffs.py
!oa4rust/backend/scripts/validate_rustsec_exceptions.py
# S4 pilot 日志离线门禁（独立 workflow 调用）。
!oa4rust/backend/scripts/pilot_gate.py
# live DB 对账脚本：111/112 声明列 ↔ information_schema 形状分叉检测（有库轮次）
!oa4rust/backend/scripts/schema_diff.py
# L-REST 无界 SELECT 扫描器：CI 的 limit-scan job 调用，基线棘轮缺它不可复现
# （见 docs/plans/2026-10-27-gap-closure-round.md §6）
!oa4rust/backend/scripts/limit_scan.py

