ALTER TABLE "x_attendance_detail" ADD COLUMN IF NOT EXISTS "update_time" TIMESTAMP;
ALTER TABLE "x_attendance_detail" ADD COLUMN IF NOT EXISTS "cycle_year" TEXT;
ALTER TABLE "x_attendance_detail" ADD COLUMN IF NOT EXISTS "cycle_month" TEXT;

