# Integration test environment variables
# Copy this file to .env.test and adjust values for your local PostgreSQL instance.

# PostgreSQL connection string for the admin database (used to create/drop test DBs).
# CI uses: postgres://o2server:password@localhost:5432/postgres
DATABASE_URL=postgres://o2server:password@localhost:5432/postgres

# Browser-session settings are explicit so tests do not depend on production defaults.
RUST_ENV=test
APP_PUBLIC_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=7200

# Optional: HMAC secret for session token signing in integration tests.
# When unset, tokens are sent unhashed.
# SESSION_HMAC_SECRET=your-secret-here
