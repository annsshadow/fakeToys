# Database
DATABASE_URL=postgres://o2server:password@localhost:5432/oa4rust

# Redis（Phase B-U-B2: 默认 session 存储）
# 默认连接本地 Redis，不可达时自动降级为内存+DB 模式。
REDIS_URL=redis://127.0.0.1:6379

# Environment
RUST_ENV=development

# Browser authentication (required explicitly when RUST_ENV=production)
# APP_PUBLIC_ORIGIN must equal the origin the browser requests the API from,
# otherwise cookie-authenticated writes (login re-submit, logout, ...) are
# rejected by the CSRF layer with 403:
# - production/nginx: the public frontend origin (e.g. https://oa.example.com)
# - local dev via the Vite proxy (frontend :5173 -> API :3000):
#   APP_PUBLIC_ORIGIN=http://localhost:5173
APP_PUBLIC_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=7200
